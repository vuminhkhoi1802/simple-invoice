# ---- Runtime ----
NODE_ENV=development
PORT=3000
# IANA timezone that defines "today" for Overdue derivation
APP_TIMEZONE=UTC

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=simple_invoice
DB_SSL=false

# ---- Auth ----
# REQUIRED, >= 32 chars. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Access-token lifetime in seconds (default 3600)
JWT_EXPIRES_IN=3600
# Set true when served over HTTPS (adds the Secure flag to the auth cookie)
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API cross-origin.
# Leave empty when the frontend is served same-origin (Vite proxy / nginx).
CORS_ORIGIN=
# Max login attempts per IP per window
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_SECONDS=60

# ---- Seed (npm run seed) ----
SEED_USER_EMAIL=admin@simpleinvoice.dev
SEED_USER_PASSWORD=
SEED_USER_FULLNAME=Demo Admin
