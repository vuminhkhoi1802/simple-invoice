# Optional overrides for docker-compose.yml. Copy to .env to use.
# Every value has a dev-only default, so `docker compose up` works without this file.

# Host ports
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=3000
DB_HOST_PORT=5432

# Database
DB_USER=postgres
DB_PASSWORD=
DB_NAME=simple_invoice

# Auth: set a real secret (>= 32 chars) for anything beyond local review.
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600
COOKIE_SECURE=false
APP_TIMEZONE=UTC

# Seeded reviewer account
SEED_USER_EMAIL=admin@simpleinvoice.dev
SEED_USER_PASSWORD=
SEED_USER_FULLNAME=Demo Admin
